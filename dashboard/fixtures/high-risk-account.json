              "Permission": "WRITE"
            }
          ]
        },
        "get_bucket_policy": {
          "Policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"PublicReadWrite\",\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":[\"s3:GetObject\",\"s3:PutObject\"],\"Resource\":\"arn:aws:s3:::public-uploads/*\"}]}"
        },
